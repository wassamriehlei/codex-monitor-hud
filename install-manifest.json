{
  "schemaVersion": 1,
  "product": "Codex Monitor HUD",
  "version": "3.4.1",
  "repository": "https://github.com/wassamriehlei/codex-monitor-hud",
  "releaseTag": "v3.4.1",
  "checksumAsset": "SHA256SUMS.txt",
  "platforms": {
    "windows-x64": {
      "asset": "CodexMonitorHUD-Portable-3.4.1-windows-x64.zip",
      "entrypoint": "CodexMonitorHUD.exe",
      "settingsArgument": "--open-settings",
      "marker": "portable.marker",
      "stateRoot": "portable-data\\CodexMonitorHUD"
    }
  },
  "rules": {
    "verifyChecksum": true,
    "extractAllFiles": true,
    "preservePortableData": true,
    "userWritableDirectory": true,
    "administratorRequired": false,
    "systemDotnetRequired": true,
    "readSessionContent": false,
    "uploadLocalData": false
  },
  "operations": [
    "run",
    "open-settings",
    "upgrade",
    "rollback"
  ],
  "health": {
    "file": "portable-data\\CodexMonitorHUD\\hud.heartbeat",
    "entrypoint": "CodexMonitorHUD.exe"
  }
}
