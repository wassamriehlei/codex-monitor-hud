<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>CodexMonitorHud</AssemblyName>
    <RootNamespace>CodexMonitorHud.App</RootNamespace>
    <AssemblyTitle>Codex Monitor HUD</AssemblyTitle>
    <Product>Codex Monitor HUD</Product>
    <Description>Local real-time Codex task monitor for Windows</Description>
    <Authors>Codex Monitor HUD Contributors</Authors>
    <Copyright>Copyright © Codex Monitor HUD Contributors</Copyright>
    <ApplicationIcon>..\..\assets\codex-monitor-hud.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.4.3</Version>
    <AssemblyVersion>3.4.3.0</AssemblyVersion>
    <FileVersion>3.4.3.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexMonitorHud.Core\CodexMonitorHud.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\*.xaml" Link="src\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\locales\*.json" Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\themes\*.json" Link="themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\config.default.json" Link="config.default.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\pricing.default.json" Link="pricing.default.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\codex-monitor-hud.ico" Link="assets\codex-monitor-hud.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
