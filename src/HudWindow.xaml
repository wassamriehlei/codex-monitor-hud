<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="HudWindow"
        Title="Codex Monitor HUD"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <!-- Cheap opacity-only status breathing. Hosts remove clocks when hidden/expanded. -->
    <Storyboard x:Key="BallBackground_active" Timeline.DesiredFrameRate="24">
      <DoubleAnimation Storyboard.TargetName="BallStatusBackground" Storyboard.TargetProperty="Opacity" From="0.12" To="0.34" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="BallBackground_listening" Timeline.DesiredFrameRate="24">
      <DoubleAnimation Storyboard.TargetName="BallStatusBackground" Storyboard.TargetProperty="Opacity" From="0.10" To="0.26" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="BallBackground_completed" FillBehavior="Stop" Timeline.DesiredFrameRate="24">
      <DoubleAnimation Storyboard.TargetName="BallStatusBackground" Storyboard.TargetProperty="Opacity" From="0.12" To="0.40" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="2x" />
    </Storyboard>
    <Storyboard x:Key="BallBackground_error" FillBehavior="Stop" Timeline.DesiredFrameRate="24">
      <DoubleAnimation Storyboard.TargetName="BallStatusBackground" Storyboard.TargetProperty="Opacity" From="0.12" To="0.42" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="2x" />
    </Storyboard>
    <Storyboard x:Key="BallBackground_aborted" FillBehavior="Stop" Timeline.DesiredFrameRate="24">
      <DoubleAnimation Storyboard.TargetName="BallStatusBackground" Storyboard.TargetProperty="Opacity" From="0.26" To="0.12" Duration="0:0:1.2" />
    </Storyboard>
    <!-- Shared by both hosts. Finite, count-only motion, separate from shell transitions. -->
    <Storyboard x:Key="BallMotion_active" FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="1" To="1.10" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="2x" />
      <DoubleAnimation Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1" To="1.10" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="2x" />
    </Storyboard>
    <Storyboard x:Key="BallMotion_listening" FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="Opacity" From="1" To="0.65" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="2x">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="BallMotion_completed" FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.82" To="1" Duration="0:0:0.42">
        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.82" To="1" Duration="0:0:0.42">
        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="BallMotion_error" FillBehavior="Stop">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" Duration="0:0:0.42">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="-2" />
        <LinearDoubleKeyFrame KeyTime="0:0:0.16" Value="2" />
        <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="-1" />
        <LinearDoubleKeyFrame KeyTime="0:0:0.32" Value="1" />
        <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="0" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="BallMotion_aborted" FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="0" To="2" Duration="0:0:0.2" AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="Opacity" From="0.65" To="1" Duration="0:0:0.4" />
    </Storyboard>
    <Storyboard x:Key="BallMotion_idle" FillBehavior="Stop">
      <DoubleAnimation Storyboard.TargetName="FloatingBallCount" Storyboard.TargetProperty="Opacity" From="0.8" To="1" Duration="0:0:0.8" />
    </Storyboard>
    <Style x:Key="HudIconButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#127B8DA8" />
      <Setter Property="BorderBrush" Value="#30FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF0A84FF" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="IconChrome"
                    CornerRadius="16"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IconChrome" Property="Background" Value="#180A84FF" />
                <Setter TargetName="IconChrome" Property="BorderBrush" Value="#520A84FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="IconChrome" Property="Background" Value="#280A84FF" />
                <Setter Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconChrome" Property="BorderBrush" Value="#FF007AFF" /></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudListToggleButton" TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Background" Value="#100A84FF" />
      <Setter Property="BorderBrush" Value="#260A84FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF0A84FF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ToggleChrome"
                    CornerRadius="16"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleChrome" Property="Background" Value="#1A0A84FF" />
                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#520A84FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ToggleChrome" Property="Background" Value="#280A84FF" />
                <Setter Property="Opacity" Value="0.84" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#FF007AFF" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="HudSurfaceMotion" Margin="18" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
    <Border x:Name="HudShell"
            CornerRadius="22"
            Padding="16,11"
            BorderThickness="1"
            SnapsToDevicePixels="True">
      <Grid>
      <StackPanel x:Name="HudContentPanel">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="StatusDot"
                   Grid.Column="0"
                   Width="8"
                   Height="8"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
          <Button x:Name="TaskListToggleButton"
                  Grid.Column="2"
                  Visibility="Collapsed"
                  Margin="8,0,2,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  MinWidth="46"
                  Style="{StaticResource HudListToggleButton}"
                  FontSize="12"
                  Cursor="Hand" />
          <WrapPanel x:Name="MetricsPanel"
                     Grid.Column="1"
                     Orientation="Horizontal"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center" />
        </Grid>
        <Border x:Name="TaskListDivider" Height="1" Background="#16000000" Margin="0,7,0,4" Visibility="Collapsed" />
        <ScrollViewer x:Name="TaskListScroller" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel x:Name="TaskListPanel" />
        </ScrollViewer>
      </StackPanel>
      <Grid x:Name="FloatingBallPanel" Width="44" Height="44" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
        <Ellipse x:Name="BallStatusBackground" IsHitTestVisible="False" Opacity="0.12">
          <Ellipse.OpacityMask><RadialGradientBrush GradientOrigin="0.4,0.35" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55"><GradientStop Color="#FFFFFFFF" Offset="0" /><GradientStop Color="#B0FFFFFF" Offset="0.65" /><GradientStop Color="#00FFFFFF" Offset="1" /></RadialGradientBrush></Ellipse.OpacityMask>
        </Ellipse>
        <TextBlock x:Name="FloatingBallCount" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform><TransformGroup><ScaleTransform /><TranslateTransform /></TransformGroup></TextBlock.RenderTransform>
        </TextBlock>
      </Grid>
      <StackPanel x:Name="QuietIndicatorPanel"
                  Visibility="Collapsed"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Grid x:Name="QuietOverallHost" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse x:Name="QuietOverallRing" Width="17" Height="17" StrokeThickness="1.5" Opacity="0.48" />
          <Ellipse x:Name="QuietOverallDot" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Border x:Name="QuietIndicatorSeparator" Width="1" Height="18" Margin="10,0,9,0" VerticalAlignment="Center" Visibility="Collapsed" />
        <StackPanel x:Name="QuietTaskIndicators" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
      </StackPanel>
      </Grid>
    </Border>
    <!-- Non-interactive optical rim follows the configured shell; no compositor changes. -->
    <Border x:Name="LiquidRim" IsHitTestVisible="False" Margin="1" BorderThickness="1" CornerRadius="{Binding CornerRadius, ElementName=HudShell}" Opacity="0.5">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
          <GradientStop Color="#BFFFFFFF" Offset="0" />
          <GradientStop Color="#00FFFFFF" Offset="0.48" />
          <GradientStop Color="#207B8DA8" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
    </Border>
  </Grid>
</Window>
