<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="TaskBubbleWindow"
        Title="Codex Monitor HUD Task"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MinWidth="0"
        MinHeight="0"
        MaxWidth="960"
        MaxHeight="360"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="HudIconButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#127B8DA8" />
      <Setter Property="BorderBrush" Value="#30FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF0A84FF" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="IconChrome" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IconChrome" Property="Background" Value="#180A84FF" />
                <Setter TargetName="IconChrome" Property="BorderBrush" Value="#520A84FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="IconChrome" Property="Background" Value="#280A84FF" />
                <Setter Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconChrome" Property="BorderBrush" Value="#FF007AFF" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Border x:Name="TaskBubbleShell" CornerRadius="18" Padding="12,9" BorderThickness="1" SnapsToDevicePixels="True">
      <DockPanel LastChildFill="True">
        <Ellipse x:Name="TaskBubbleStatusDot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" />
        <Button x:Name="TaskBubbleDismissButton" DockPanel.Dock="Right" Style="{StaticResource HudIconButton}" Margin="5,0,0,0">
          <Viewbox Width="14" Height="14">
            <Path Data="M18,6 L6,18 M6,6 L18,18"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
          </Viewbox>
        </Button>
        <Button x:Name="TaskBubbleMergeButton" DockPanel.Dock="Right" Style="{StaticResource HudIconButton}" Margin="9,0,0,0">
          <Viewbox Width="15" Height="15">
            <Path Data="M14,10 L21,3 M20,10 H14 V4 M3,21 L10,14 M4,14 H10 V20"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.7"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
          </Viewbox>
        </Button>
        <StackPanel x:Name="TaskBubbleContent">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="TaskBubbleSourceBadge" CornerRadius="7" Padding="4,3" Margin="0,0,6,0" BorderThickness="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="14" Height="14">
                  <Path x:Name="TaskBubbleSourceIcon"
                        StrokeThickness="1.45"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock x:Name="TaskBubbleNumber" Margin="3,0,0,0" VerticalAlignment="Center" FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="TaskBubbleName" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <Border x:Name="TaskBubbleContextMetric" CornerRadius="7" Padding="6,2" Margin="0,0,7,0" BorderThickness="1">
              <TextBlock x:Name="TaskBubbleContextText" FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="TaskBubbleMetrics" MaxWidth="520" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI" FontSize="12" TextWrapping="NoWrap" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Non-interactive optical rim follows the configured shell; no compositor changes. -->
    <Border x:Name="LiquidRim" IsHitTestVisible="False" Margin="1" BorderThickness="1" CornerRadius="{Binding CornerRadius, ElementName=TaskBubbleShell}" Opacity="0.5">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
          <GradientStop Color="#BFFFFFFF" Offset="0" />
          <GradientStop Color="#00FFFFFF" Offset="0.48" />
          <GradientStop Color="#207B8DA8" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
    </Border>
    <Thumb x:Name="TaskBubbleResizeThumb"
           Width="18"
           Height="18"
           Margin="0,0,4,4"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Cursor="SizeNWSE"
           Opacity="0.62">
      <Thumb.Template>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Background="Transparent">
            <Path Data="M19,13 V19 H13 M5,11 V5 H11 M19,5 L12,12 M5,19 L12,12"
                  Stroke="#A60A84FF"
                  StrokeThickness="1.6"
                  Stretch="Uniform"
                  Width="14"
                  Height="14"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
          </Grid>
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>
  </Grid>
</Window>
