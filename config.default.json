{
  "preset": "ios26-liquid",
  "language": "zh-CN",
  "surfaceMode": "ball",
  "startWithWindows": false,
  "floatingBallSize": 60,
  "showProviderLabel": false,
  "layout": "compact",
  "numberFormat": "auto",
  "monitorScope": "aggregate",
  "activeWindowMinutes": 30,
  "sessionSources": {
    "desktop": true,
    "vscode": true,
    "defaultCli": true,
    "deepSeekCli": true
  },
  "multiTask": {
    "displayMode": "list",
    "listStyle": "cards",
    "listDensity": "compact",
    "listDetail": "balanced",
    "nameMode": "always",
    "maxSplitBubbles": 6,
    "autoSplitNewTasks": true,
    "numberCooldownSeconds": 120,
    "listFields": {
      "directory": true,
      "time": true,
      "context": true,
      "status": true,
      "model": false,
      "callTotal": true,
      "cacheHitRate": false,
      "taskTotal": false,
      "estimatedCost": false,
      "updated": false
    },
    "bubbleFields": {
      "model": true,
      "callTotal": true,
      "cacheHitRate": false,
      "taskTotal": false,
      "estimatedCost": false,
      "updated": true
    }
  },
  "behavior": {
    "openTaskOnDoubleClick": false,
    "edgeSnap": {
      "enabled": true,
      "distance": 28
    },
    "idleIndicator": {
      "enabled": false,
      "afterMinutes": 15,
      "layout": "overall",
      "taskStyle": "dot",
      "includeTaskBubbles": true
    },
    "contextAlerts": {
      "enabled": false,
      "thresholds": [
        75,
        90,
        98
      ]
    }
