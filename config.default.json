{
  "preset": "ios26-liquid",
  "language": "en",
  "surfaceMode": "window",
  "layout": "compact",
  "numberFormat": "exact",
  "monitorScope": "aggregate",
  "activeWindowMinutes": 30,
  "sessionSources": {
    "desktop": true,
    "vscode": true,
    "defaultCli": true,
    "deepSeekCli": true
  },
  "multiTask": {
    "displayMode": "summary",
    "listStyle": "cards",
    "listDensity": "compact",
    "listDetail": "balanced",
    "nameMode": "always",
    "maxSplitBubbles": 6,
    "autoSplitNewTasks": true,
    "numberCooldownSeconds": 120,
    "listFields": {
      "directory": true,
      "time": true,
      "context": true,
      "status": true,
      "model": true,
      "callTotal": true,
      "cacheHitRate": true,
      "taskTotal": false,
      "estimatedCost": false,
      "updated": false
    },
    "bubbleFields": {
      "model": true,
      "callTotal": true,
      "cacheHitRate": false,
      "taskTotal": true,
      "estimatedCost": false,
      "updated": true
    }
  },
  "behavior": {
    "openTaskOnDoubleClick": false,
    "edgeSnap": {
      "enabled": true,
      "distance": 28
    },
    "idleIndicator": {
      "enabled": false,
      "afterMinutes": 15,
      "layout": "overall",
      "taskStyle": "dot",
      "includeTaskBubbles": true
    },
    "contextAlerts": {
      "enabled": false,
      "thresholds": [
        75,
        90,
        98
      ]
    }
  },
  "attention": {
    "summaryMode": "halo",
    "listMode": "halo",
    "taskBubbleMode": "halo",
    "dotEnabled": true,
    "dotPattern": "soft",
    "dotBrightness": "subtle",
    "dotSpeed": "slow",
    "dotBreathing": true,
    "durationSeconds": 6,
    "completionGraceSeconds": 8,
    "onCompleted": true,
    "onAbortedOrError": true,
    "onSettled": false
  },
  "completionSound": "off",
  "completionSoundFile": "",
  "agentNotifications": {
    "enabled": false,
    "permission": "text",
    "mode": "focus",
    "durationSeconds": 12,
    "color": "#FF7C3AED",
    "glowPreset": "violet",
    "intensity": "balanced"
  },
  "quotaGuard": {
    "enabled": false,
    "prepareFiveHourPercent": 15,
    "prepareWeeklyPercent": 10,
    "handoffFiveHourPercent": 5,
    "handoffWeeklyPercent": 3,
    "prepareInstruction": "",
    "handoffInstruction": ""
  },
  "officialAllowance": {
    "enabled": false
  },
  "separator": "dot",
  "position": "top-right",
  "customLeft": null,
  "customTop": null,
  "hudWidth": 900,
  "fontSize": 14,
  "cornerRadius": 28,
  "opacity": 0.97,
  "transparencyMode": "uniform",
  "scale": 1,
  "alwaysOnTop": true,
  "mousePassthrough": false,
  "showStatusDot": true,
  "animateUpdates": true,
  "themeStyle": {
    "backdrop": "none",
    "surface": "gradient",
    "gradientStart": "#FAFFFFFF",
    "gradientEnd": "#F0E8EEF7",
    "gradientAngle": 105,
    "backgroundImage": "",
    "imageOpacity": 0.28,
    "imageStretch": "uniformToFill",
    "shadow": "soft",
    "borderWidth": 1,
    "statusDotSize": 7,
    "fontFamily": "HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI"
  },
  "statusPalette": "default",
  "statusColors": {
    "active": "#FF248A3D",
    "listening": "#FF007AFF",
    "idle": "#FF8E8E93",
    "paused": "#FFB86E00",
    "error": "#FFD70015",
    "completed": "#FF248A3D",
    "aborted": "#FFD70015"
  },
  "statusTiming": {
    "activeSeconds": 12,
    "idleSeconds": 90,
    "errorHoldSeconds": 30,
    "terminalHoldSeconds": 120,
    "terminalExitMode": "gentle"
  },
  "background": "#F5F5F7FB",
  "foreground": "#FF1C1C1E",
  "muted": "#FF636773",
  "accent": "#FF007AFF",
  "border": "#E6FFFFFF",
  "pricing": {
    "path": ""
  },
  "fields": {
    "input": false,
    "cached": true,
    "cacheHitRate": false,
    "uncached": true,
    "output": true,
    "reasoning": false,
    "callTotal": true,
    "taskTotal": false,
    "context": false,
    "model": false,
    "updated": false,
    "activeTasks": true,
    "weeklyRemaining": true,
    "fiveHourRemaining": true,
    "estimatedCost": false
  }
}
