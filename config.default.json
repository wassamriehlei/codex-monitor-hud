  "attention": {
    "summaryMode": "halo",
    "listMode": "halo",
    "taskBubbleMode": "halo",
    "dotEnabled": true,
    "dotPattern": "soft",
    "dotBrightness": "subtle",
    "dotSpeed": "slow",
    "dotBreathing": true,
    "durationSeconds": 6,
    "completionGraceSeconds": 8,
    "onCompleted": true,
    "onAbortedOrError": true,
    "onSettled": false
  },
  "completionSound": "file",
  "completionSoundFile": "assets/audio/default-completion.mp3",
  "agentNotifications": {
    "enabled": false,
    "permission": "text",
    "mode": "focus",
    "durationSeconds": 12,
    "color": "#FF7C3AED",
    "glowPreset": "violet",
    "intensity": "balanced"
  },
  "quotaGuard": {
    "enabled": false,
    "prepareFiveHourPercent": 15,
    "prepareWeeklyPercent": 10,
    "handoffFiveHourPercent": 5,
    "handoffWeeklyPercent": 3,
    "prepareInstruction": "额度已进入预警。在开始下一项高消耗或大范围工作前，先检查当前项目是否已有交接文档或约定的收尾格式；若有，按其更新。若没有，在项目合适位置写一份简洁、可恢复的交接：当前目标和进度、已改文件、已验证内容、未完成事项和下次的确切命令。完成后再决定是否继续。",
    "handoffInstruction": "额度接近断档。不要开始新的大范围或高消耗工作；立即优先更新项目已有交接文档或约定格式。若没有，写一份可恢复交接：当前目标和进度、已改文件、已验证内容、未完成事项、风险或阻塞及下次的确切命令。保存后停止扩张范围，以便下次从这里继续。"
  },
  "officialAllowance": {
    "enabled": false
  },
  "separator": "dot",
